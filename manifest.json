{
  "manifest_version": 3,
  "name": "Reminder",
  "version": "1.0.0",
  "description": "A simple reminder extension to set custom reminders for anything.",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  }
}